---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import TerminalBackground from '../components/TerminalBackground.astro';

const focusAreas = [
	{
		number: '01',
		title: 'Cybersecurity',
		description:
			'Building practical knowledge in security operations, incident response, vulnerability management, endpoint security, and digital forensics.',
		skills: [
			'Incident Response',
			'Endpoint Security',
			'Vulnerability Management',
			'Digital Forensics',
		],
	},
	{
		number: '02',
		title: 'Network Security',
		description:
			'Designing, securing, and troubleshooting networks across firewalls, wireless infrastructure, segmentation, and WAN connectivity.',
		skills: [
			'VLANs',
			'Firewalls',
			'Wireless',
			'WAN Failover',
			'Traffic Analysis',
		],
	},
	{
		number: '03',
		title: 'Systems Administration',
		description:
			'Supporting Windows endpoints, identity platforms, device deployments, business applications, and distributed technology environments.',
		skills: [
			'Microsoft Intune',
			'Entra ID',
			'Microsoft 365',
			'Windows',
			'PowerShell',
		],
	},
];

const projects = [
	{
		category: 'Network Security',
		title: 'Secure Retail Branch Network',
		description:
			'A segmented branch-network design separating corporate, point-of-sale, guest, IoT, and management traffic.',
		tools: ['VLANs', 'Firewall Rules', 'VPN', 'Wireless'],
	},
	{
		category: 'Security Operations',
		title: 'Security Monitoring Lab',
		description:
			'A defensive lab for collecting logs, detecting suspicious activity, investigating alerts, and documenting incident-response procedures.',
		tools: ['Wazuh', 'Sysmon', 'Windows', 'MITRE ATT&CK'],
	},
	{
		category: 'Identity and Endpoints',
		title: 'Entra ID and Intune Lab',
		description:
			'A Microsoft cloud lab demonstrating device enrollment, compliance policies, identity controls, and endpoint hardening.',
		tools: ['Entra ID', 'Intune', 'Defender', 'Conditional Access'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<TerminalBackground />
		<Header />

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">
						<span class="status-dot" aria-hidden="true"></span>
						Vancouver, British Columbia
					</p>

					<h1 id="hero-title">
						I support and secure the systems behind
						<span>modern infrastructure.</span>
					</h1>

					<p class="hero-description">
						I’m Shahzaib Hussain, a technology professional building deeper expertise
						in cybersecurity, network security, and systems administration through
						professional experience, academic study, and hands-on labs.
					</p>

					<div class="hero-actions">
						<a class="button button-primary" href="#projects">Explore my work</a>
						<a class="button button-secondary" href="/about">About me</a>
					</div>
				</div>

				<aside class="system-card" aria-label="Professional profile">
					<div class="system-card-header">
						<span>professional-profile.yml</span>

						<div class="window-controls" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</div>
					</div>

					<div class="system-card-body">
						<p><span class="property">name:</span> Shahzaib Hussain</p>
						<p><span class="property">location:</span> Vancouver, BC</p>
						<p><span class="property">focus:</span></p>

						<ul>
							<li>cybersecurity</li>
							<li>network_security</li>
							<li>systems_administration</li>
						</ul>

						<p><span class="property">education:</span></p>

						<ul>
							<li>BCIT Digital Forensics</li>
							<li>& Cybersecurity BTech</li>
						</ul>

						<p>
							<span class="property">status:</span>
							<span class="value">building_and_learning</span>
						</p>
					</div>
				</aside>
			</section>

			<section class="stats" aria-label="Professional highlights">
				<div>
					<strong>3</strong>
					<span>Technical disciplines</span>
				</div>

				<div>
					<strong>Enterprise</strong>
					<span>Retail IT experience</span>
				</div>

				<div>
					<strong>BCIT</strong>
					<span>Cybersecurity education</span>
				</div>

				<div>
					<strong>Hands-on</strong>
					<span>Infrastructure focus</span>
				</div>
			</section>

			<section id="expertise" class="section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Core disciplines</p>
						<h2>Where security meets infrastructure</h2>
					</div>

					<p>
						My experience connects technology operations with the security,
						reliability, and documentation required to support distributed
						environments.
					</p>
				</div>

				<div class="focus-grid">
					{
						focusAreas.map((area) => (
							<article class="focus-card">
								<span class="card-number">{area.number}</span>
								<h3>{area.title}</h3>
								<p>{area.description}</p>

								<div class="tag-list">
									{area.skills.map((skill) => <span>{skill}</span>)}
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section id="projects" class="section">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Featured projects</p>
						<h2>Learning demonstrated through implementation</h2>
					</div>

					<p>
						These projects will become detailed case studies containing architecture,
						implementation decisions, testing evidence, and lessons learned.
					</p>
				</div>

				<div class="project-grid">
					{
						projects.map((project) => (
							<article class="project-card">
								<div class="project-meta">
									<span>{project.category}</span>
									<span>Case study planned</span>
								</div>

								<h3>{project.title}</h3>
								<p>{project.description}</p>

								<div class="tag-list">
									{project.tools.map((tool) => <span>{tool}</span>)}
								</div>

								<span class="project-link">Documentation coming soon →</span>
							</article>
						))
					}
				</div>
			</section>

			<section class="section blog-preview">
				<div>
					<p class="eyebrow">Field notes</p>
					<h2>Technical writing and lab documentation</h2>
					<p>
						I use my blog to document network designs, security investigations,
						troubleshooting methods, labs, and lessons learned.
					</p>
				</div>

				<a class="button button-primary" href="/blog">Read the blog</a>
			</section>

			<section class="section contact-section">
				<p class="eyebrow">Let’s connect</p>
				<h2>Cybersecurity, networking, and dependable infrastructure.</h2>
				<p>
					This portfolio is actively being developed as I document new projects,
					labs, and technical knowledge.
				</p>

				<div class="hero-actions">
					<a class="button button-primary" href="/about">Learn more about me</a>
					<a class="button button-secondary" href="#top">Return to top</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>