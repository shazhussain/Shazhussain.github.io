---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import TerminalBackground from '../components/TerminalBackground.astro';

const pageTitle = `About | ${SITE_TITLE}`;
const description =
	'Learn about Shahzaib Hussain’s experience across cybersecurity, networking, systems administration, and retail technology.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={description} />
	</head>

	<body>
		<TerminalBackground />
		<Header />

		<main class="about-page">
			<section class="about-introduction">
				<p class="eyebrow">About me</p>
				<h1>Technology operations with a growing security focus.</h1>

				<p class="lead">
					I’m Shahzaib Hussain, a Vancouver-based technology professional with
					hands-on experience supporting networking, endpoint management, business
					systems, and distributed retail infrastructure.
				</p>
			</section>

			<section class="about-grid">
				<article>
					<p class="eyebrow">Professional background</p>
					<h2>Infrastructure in real environments</h2>

					<p>
						My work involves troubleshooting technology incidents, supporting
						network and wireless infrastructure, preparing endpoints, coordinating
						deployments, working with vendors, and documenting repeatable technical
						processes.
					</p>

					<p>
						This experience has shown me how networking, identity, endpoints,
						applications, and security controls depend on one another in operational
						environments.
					</p>
				</article>

				<article>
					<p class="eyebrow">Education</p>
					<h2>Digital Forensics and Cybersecurity</h2>

					<p>
						I completed BCIT’s Computer Information Systems Administration program
						and am continuing my education through the Bachelor of Technology in
						Digital Forensics and Cybersecurity.
					</p>

					<p>
						My current learning priorities include network security, incident
						response, digital forensics, identity security, endpoint protection,
						and security automation.
					</p>
				</article>
			</section>

			<section class="principles">
				<p class="eyebrow">How I work</p>

				<div class="principle-grid">
					<article>
						<span>01</span>
						<h3>Understand the environment</h3>
						<p>Establish the scope, dependencies, impact, and expected behaviour.</p>
					</article>

					<article>
						<span>02</span>
						<h3>Follow the evidence</h3>
						<p>Use logs, configuration, monitoring, and testing to validate assumptions.</p>
					</article>

					<article>
						<span>03</span>
						<h3>Document the outcome</h3>
						<p>Record the cause, resolution, validation, and lessons learned.</p>
					</article>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-page {
		padding-bottom: 4rem;
	}

	.about-introduction {
		max-width: 900px;
		padding: 7rem 0 5rem;
		border-bottom: 1px solid var(--border);
	}

	.about-introduction h1 {
		font-size: clamp(2.7rem, 6vw, 5.2rem);
	}

	.lead {
		max-width: 760px;
		margin-top: 1.75rem;
		font-size: 1.2rem;
	}

	.about-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		padding: 5rem 0;
	}

	.about-grid article,
	.principle-grid article {
		padding: 1.75rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: rgba(13, 26, 43, 0.72);
	}

	.about-grid h2 {
		font-size: 2rem;
	}

	.about-grid article > p:not(.eyebrow) {
		margin-top: 1.25rem;
	}

	.principles {
		padding-bottom: 5rem;
	}

	.principle-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.principle-grid span {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.principle-grid h3 {
		margin-top: 1.5rem;
	}

	.principle-grid p {
		margin-top: 0.75rem;
	}

	@media (max-width: 800px) {
		.about-grid,
		.principle-grid {
			grid-template-columns: 1fr;
		}
	}
</style>