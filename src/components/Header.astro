---
import { SITE_TITLE } from '../consts';
---

<header id="top">
	<nav aria-label="Primary navigation">
		<a class="brand" href="/">
			<span class="brand-mark">SH</span>
			<span>{SITE_TITLE}</span>
		</a>

		<div class="navigation-links">
			<a href="/">Home</a>
			<a href="/#expertise">Expertise</a>
			<a href="/#projects">Projects</a>
			<a href="/blog">Blog</a>
			<a href="/about">About</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		background: rgba(6, 12, 22, 0.9);
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border);
		background: rgba(6, 12, 22, 0.9);
		backdrop-filter: blur(18px);
	}

	nav {
		width: min(1180px, calc(100% - 2rem));
		min-height: 74px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--text-primary);
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand:hover {
		color: var(--text-primary);
	}

	.brand-mark {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		flex-shrink: 0;
		border: 1px solid var(--accent);
		border-radius: 10px;
		background: var(--accent-soft);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.navigation-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}

	.navigation-links a {
		padding: 0.65rem 0.75rem;
		border-radius: 8px;
		color: var(--text-secondary);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
	}

	.navigation-links a:hover {
		background: var(--surface);
		color: var(--text-primary);
	}

	@media (max-width: 820px) {
		nav {
			min-height: auto;
			padding: 0.85rem 0;
			align-items: flex-start;
			flex-direction: column;
			gap: 0.65rem;
		}

		.navigation-links {
			width: 100%;
			overflow-x: auto;
			padding-bottom: 0.25rem;
		}

		.navigation-links a {
			white-space: nowrap;
		}
	}
</style>